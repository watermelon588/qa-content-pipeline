# Copy to .env.local and fill in. Values starting NEXT_PUBLIC_ end up in the browser; the others stay on the server.

# --- Server only (the admin screens) ---
# Where the FastAPI backend runs.
API_URL=http://localhost:8000
# Must equal CRON_SECRET in api/.env. The admin's server code sends it to the API; the browser never sees it.
CRON_SECRET=
# Login for /admin (the browser shows its own login box). With no password set, /admin stays closed.
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Public ---

# Where the site lives. Used for the sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=https://gpu.aiatlasindia.com

# GA4 measurement ID from Vyohm (looks like G-XXXXXXXXXX). Leave empty until they send it: no tag is added.
NEXT_PUBLIC_GA_ID=
