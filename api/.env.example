# Copy this file to api/.env and fill in the values. Never commit api/.env.
# A blank LLM key means that provider is skipped.

# Neon dashboard -> your project -> Connect -> connection string
DATABASE_URL=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Any long random string. The scheduler sends it as "Authorization: Bearer <secret>" to /jobs/*.
CRON_SECRET=

# Level 4, emailing the expert. https://resend.com/api-keys. Leave blank to get the review link on the admin
# screen instead. Resend's test sender (the MAIL_FROM default) can only email the address you signed up with.
RESEND_API_KEY=
# Where the review email goes. Use your OWN address (the one your Resend account uses) and forward it to the expert.
EXPERT_EMAIL=
MAIL_FROM=AI Atlas India <onboarding@resend.dev>
# The web app's address (review links and answer pages). http://localhost:3000 while testing.
SITE_URL=http://localhost:3000

# Level 5, Bluesky. The handle, and an APP password from Settings > Privacy and security > App passwords
# (not the account password). Then run once: .venv/Scripts/python -m social.setup  (adds the "bot" label)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# "dev" (default) uses light, fast models. Set to "final" before submitting to use the stronger ones.
LLM_MODE=dev
