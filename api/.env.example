# Copy this file to api/.env and fill in the values. Never commit api/.env.
# A blank LLM key means that provider is skipped.

# Neon dashboard -> your project -> Connect -> connection string
DATABASE_URL=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.groq.com/keys
GROQ_API_KEY=
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
